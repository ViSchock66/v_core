# V-CORE — plantilla de configuración
#
# Copiar a .env y completar. El archivo .env está en .gitignore y NO se
# commitea: nunca poner claves reales acá.
#
#     cp .env.example .env
#
# api/main.py carga este archivo al arrancar (python-dotenv, override=True).

# --- Proveedores LLM -------------------------------------------------------
# NVIDIA NIM: el sistema usa un pool de 4 claves que rotan. El credential
# pooling y el circuit breaker aislan la que falle o se agote.
NVIDIA_KEY_MAIN=
NVIDIA_KEY_FALLBACK=
NVIDIA_KEY_COMPRESS=
NVIDIA_KEY_AUX=

# Clave genérica (algunos módulos la leen directo, p.ej. la auditoría visual)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Proveedores alternativos — opcionales, cada uno se activa solo si tiene clave
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_TOKEN=

# --- Embeddings / Ollama ---------------------------------------------------
# Ollama local es la primera capa del fallback de embeddings
# (Ollama -> NIM -> hash SHA-256). Si no está, el sistema degrada solo.
OLLAMA_HOST=http://127.0.0.1:11434

# --- Rutas -----------------------------------------------------------------
# Vacías = se resuelven relativo a la raíz del repo. Poner valores absolutos
# solo si se mueve el checkout.
VCORE_ROOT=
VCORE_DB=
VCORE_DATA=

# --- Routing (informativo) -------------------------------------------------
# El routing real vive en model_routing.yaml y se cambia en caliente con
# POST /system/model. Estas variables son compatibilidad heredada.
MODEL_LEAD=
LLM_BACKEND=nvidia
LLM_MODEL=
TIER_ACTIVO=1
